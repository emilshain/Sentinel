# Backend base URL. Unset defaults to http://localhost:8000, which is where the
# uvicorn command in backend/README.md serves.
#
# The origin this UI is served from must be in the backend's CORS allowlist -
# localhost:5173 and :4173 are allowed by default. Vite has strictPort false, so
# a busy 5173 rolls to 5174; if that happens, start the backend with
# SENTINEL_CORS_ORIGINS set to match or preflight requests will fail.
VITE_API_BASE=http://localhost:8000

# Development convenience only. The Vite dev/preview server exposes the
# committed golden run at /report.json (see vite.config.js). The dashboard reads
# the backend by default and falls back to public/golden_run.json when the
# backend is unreachable, so this is not on the normal path.
VITE_REPORT_PATH=/report.json
